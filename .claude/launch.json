{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "servidor"
      ],
      "port": 4173
    },
    {
      "name": "equipo-prueba",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=4180",
        "GESTOR_DATOS=servidor/datos-prueba",
        "node",
        "servidor/index.ts"
      ],
      "port": 4180
    },
    {
      "name": "dev-prueba",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "GESTOR_API=http://localhost:4180",
        "npx",
        "vite",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    }
  ]
}
