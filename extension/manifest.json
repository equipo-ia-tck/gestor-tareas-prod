{
  "manifest_version": 3,
  "name": "Marea · Lista",
  "version": "1.1.0",
  "description": "Sincroniza Marea con tu Microsoft List de SharePoint en segundo plano, con tu sesión de SharePoint.",
  "permissions": ["scripting"],
  "host_permissions": ["https://*.sharepoint.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://gestor-tareas-prod.vercel.app/*",
        "https://gestor-tareas-prod-git-dev-ia-geeks.vercel.app/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": { "128": "icon.png" }
}
