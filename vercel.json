{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/rally/:route*", "destination": "/api/rally?route=:route*" },
    { "source": "/api/calendario-extra/:route*", "destination": "/api/calendario-extra?route=:route*" },
    { "source": "/.well-known/oauth-protected-resource/:path*", "destination": "/api/mcp?route=prm" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/mcp?route=prm" },
    { "source": "/.well-known/oauth-authorization-server/:path*", "destination": "/api/mcp?route=asm" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/mcp?route=asm" },
    { "source": "/oauth-consent", "destination": "/index.html" }
  ],
  "functions": { "api/rally.ts": { "maxDuration": 120 }, "api/calendario-extra.ts": { "maxDuration": 30 }, "api/mcp.ts": { "maxDuration": 60 } }
}
